# Flask Application Configuration
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=replace_with_a_strong_secret_key

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=student_attendance_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DATABASE_URL=postgresql+psycopg://postgres:your_postgres_password@localhost:5432/student_attendance_db

# Redis Configuration (Cache Layer for Dynamic PIN TTL)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# Attendance Session Settings
PIN_LENGTH=6
PIN_TTL_SECONDS=300
ABSENCE_WARNING_THRESHOLD=0.20

# Email System Configuration (SMTP for Reset Password & Absence Warning Email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=noreply@westbridge.edu
